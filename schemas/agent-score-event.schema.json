{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "scoreType": {
      "type": "string"
    },
    "delta": {
      "type": "integer"
    },
    "oldScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "newScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "scoreType",
    "delta",
    "oldScore",
    "newScore",
    "reason"
  ]
}
