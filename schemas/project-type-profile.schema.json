{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plutomix/project-type-profile/1.0",
  "title": "PlutoMix Project Type Profile",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "status", "detection", "capabilities", "availableRoles", "defaultRoles", "scoringDimensions", "validationPipeline", "executionAdapter", "previewAdapter", "limits"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$" },
    "status": { "enum": ["supported", "experimental", "unsupported"] },
    "previewAdapter": { "enum": ["browser", "api-contract", "artifact", "none"] },
    "scoringDimensions": { "type": "array", "minItems": 1 },
    "limits": { "type": "object", "required": ["maximumParallelReaders", "maximumWriters", "maximumRepairCycles"] }
  }
}
