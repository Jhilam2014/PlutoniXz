{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QAgent Decision Continuity Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "hypothesis", "experiment", "affectedBranches", "expectedInformationGain", "requestedEvidence", "estimate", "stopCondition"],
  "properties": {
    "question": { "type": "string", "minLength": 8, "maxLength": 1600 },
    "hypothesis": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "experiment": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "affectedBranches": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["branchId", "relevance", "evidenceGap"],
        "properties": {
          "branchId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "relevance": { "enum": ["direct", "comparative", "context_only"] },
          "evidenceGap": { "type": "string", "minLength": 8, "maxLength": 1200 }
        }
      }
    },
    "expectedInformationGain": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "proxy", "calibrationVersion"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "proxy": { "type": "string", "minLength": 1, "maxLength": 160 },
        "calibrationVersion": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "requestedEvidence": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "toolId", "type", "freshnessMs", "purpose"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 160 },
          "toolId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "type": { "enum": ["metric", "test", "artifact", "research", "catalog"] },
          "freshnessMs": { "type": "integer", "minimum": 0, "maximum": 604800000 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 800 }
        }
      }
    },
    "estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["tokens", "modelCalls", "toolCalls", "latencyMs", "monetaryCostUsd", "computeUnits", "evidenceBytes", "risk"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0, "maximum": 12000 },
        "modelCalls": { "type": "integer", "minimum": 0, "maximum": 2 },
        "toolCalls": { "type": "integer", "minimum": 0, "maximum": 2 },
        "latencyMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "monetaryCostUsd": { "type": "number", "minimum": 0, "maximum": 1 },
        "computeUnits": { "type": "number", "minimum": 0, "maximum": 4 },
        "evidenceBytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
        "risk": { "enum": ["low", "medium", "high"] }
      }
    },
    "stopCondition": { "enum": ["sufficient_evidence", "low_expected_value", "evidence_unavailable", "timeout"] }
  }
}
