{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "correctionSummary": {
      "type": "string"
    },
    "correctionType": {
      "type": "string"
    },
    "repeatedCount": {
      "type": "integer",
      "minimum": 0
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "resolved": {
      "type": "boolean"
    }
  },
  "required": [
    "agent_id",
    "correctionSummary",
    "correctionType",
    "severity"
  ]
}
