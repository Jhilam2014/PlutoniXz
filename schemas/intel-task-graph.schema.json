{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plutomix/intel-task-graph/1.0",
  "title": "PlutoMix Intel Task Graph",
  "type": "object",
  "required": ["schemaVersion", "workflowId", "profileId", "objective", "projectId", "projectRoot", "nodes", "edges", "limits"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "dependencies", "permissions", "status"],
        "properties": {
          "permissions": { "enum": ["read-only", "workspace-write"] },
          "status": { "enum": ["planned", "queued", "running", "completed", "failed", "skipped", "cancelled"] }
        }
      }
    }
  }
}
