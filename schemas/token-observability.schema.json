{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plutonix.local/schemas/token-observability.schema.json",
  "title": "Token Observability Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "task_size",
    "context_budget",
    "model_provider",
    "model_name",
    "agent_id",
    "phase",
    "input_tokens",
    "output_tokens",
    "cached_input_tokens",
    "reasoning_tokens",
    "tool_calls_count",
    "files_read_count",
    "files_modified_count",
    "memory_queries_count",
    "graph_queries_count",
    "estimated_cost",
    "currency",
    "published_at",
    "source",
    "token_saving_decisions"
  ],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "task_size": { "enum": ["tiny", "small", "medium", "large"] },
    "context_budget": { "enum": ["micro_context", "small_context", "medium_context", "large_context"] },
    "model_provider": { "type": "string" },
    "model_name": { "type": "string" },
    "agent_id": { "type": "string" },
    "phase": {
      "enum": ["bootstrap", "planning", "retrieval", "execution", "validation", "memory_sync", "graph_update", "final_response"]
    },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "cached_input_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "tool_calls_count": { "type": "integer", "minimum": 0 },
    "files_read_count": { "type": "integer", "minimum": 0 },
    "files_modified_count": { "type": "integer", "minimum": 0 },
    "memory_queries_count": { "type": "integer", "minimum": 0 },
    "graph_queries_count": { "type": "integer", "minimum": 0 },
    "estimated_cost": { "type": "number", "minimum": 0 },
    "currency": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["runtime", "estimated", "unavailable"] },
    "token_saving_decisions": { "type": "array", "items": { "type": "string" } }
  }
}
