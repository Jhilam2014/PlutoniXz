{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlutoMix Gotham Policy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "precedence", "packs"],
  "properties": {
    "schemaVersion": { "const": "plutomix-policy-manifest/v1" },
    "version": { "type": "string", "minLength": 1 },
    "precedence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "contentHash", "lifecycle", "taskSizes", "domains", "risks", "mandatory", "precedence", "incompatibleWith"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^[a-z0-9./-]+\\.md$" },
          "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "lifecycle": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "taskSizes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "domains": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "risks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "mandatory": { "type": "boolean" },
          "precedence": { "type": "number" },
          "incompatibleWith": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
