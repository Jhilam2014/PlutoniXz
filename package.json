    "secret:artifacts:08a1d": "node scripts/scan-08a1d-artifacts.mjs --run-id 20260811T214249Z --manifest runtime/secret-scan/20260811T214249Z/canonical-inventory.08a1b.sanitized.json --scan-summary runtime/secret-scan/20260811T214249Z/summary.jsonl --report-dir runtime/secret-scan/20260811T214249Z/artifact-coverage-08a1d --output-json runtime/secret-scan/20260811T214249Z/artifact-coverage.08a1d.sanitized.json",
