{
  "name": "plutonix",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous multi-artifact creation system for applications, tools, documents, PDFs, workbooks, visual assets, media, APIs, and automations.",
  "scripts": {
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:generated": "npm --prefix apps/generated-site run dev",
    "validate": "python3 scripts/validate_project.py",
    "compose:config": "docker compose config",
    "secret:scan": "sh scripts/secret-scan.sh scan",
    "secret:scan:verify-fixture": "sh scripts/secret-scan.sh verify-fixture",
    "secret:reconcile:08a": "node scripts/reconcile-secret-findings.mjs --source-report runtime/secret-scan/08a-manual-20260810/reachable-git-history.gitleaks.json --output-json runtime/secret-scan/08a1-local/finding-reconciliation.sanitized.json --output-markdown docs/production-readiness/evidence/08a-finding-reconciliation.md --run-id 08a1-local",
    "secret:reconcile:08a:verify": "node scripts/verify-08a-reconciliation.mjs --source-report runtime/secret-scan/08a-manual-20260810/reachable-git-history.gitleaks.json --manifest runtime/secret-scan/08a1-local/finding-reconciliation.sanitized.json",
    "secret:artifacts:08a": "node scripts/inventory-08a-artifacts.mjs --output-json runtime/secret-scan/08a1-local/artifact-inventory.sanitized.json --output-markdown docs/production-readiness/evidence/08a-artifact-inventory.md --run-id 08a1-local",
    "secret:artifacts:08a:verify": "node scripts/verify-08a-artifact-inventory.mjs --inventory runtime/secret-scan/08a1-local/artifact-inventory.sanitized.json",
    "secret:verify:08a1a": "node scripts/verify-08a1a-owner-evidence.mjs",
    "secret:reconcile:08a1b": "sh scripts/reconcile-08a1b-r2.sh",
    "secret:reconcile:08a1b:test": "node scripts/test-08a1b-r2-reconstruction.mjs",
    "secret:reconcile:08a1b:verify": "node scripts/verify-08a1b-r2-reconstruction.mjs --inventory docs/production-readiness/evidence/08a1b-r2-logical-credential-inventory.sanitized.json --require-pass",
    "secret:reconcile:08a1b:atomic": "sh scripts/reconcile-08a1b-r2-r3-atomic.sh",
    "secret:reconcile:08a1b:atomic:test": "node scripts/test-08a1b-r2-r3-atomic.mjs",
    "secret:reconcile:08a1b:semantic-publication:test": "node scripts/test-08a1b-r3-semantic-publication.mjs",
    "secret:reconcile:08a1b:atomic:publish": "node scripts/reconcile-08a1b-r2-r3-atomic.mjs --publish-existing --repository-root . --output-inventory docs/production-readiness/evidence/08a1b-r2-logical-credential-inventory.sanitized.json --output-classification docs/production-readiness/evidence/08a1b-r3-semantic-classification.sanitized.json --output-policy docs/production-readiness/evidence/08a1b-r3-semantic-policy.md --output-precision docs/production-readiness/evidence/08a1b-r3-rule-precision-summary.md --output-summary docs/production-readiness/evidence/08a1b-r3-semantic-classification.md",
    "secret:reconcile:08a1b:atomic:verify": "npm run secret:reconcile:08a1b:verify && npm run secret:reconcile:08a1b:r3:verify && npm run secret:artifacts:08a1d:verify",
    "secret:reconcile:08a1b:r3": "sh scripts/reconcile-08a1b-r3.sh",
    "secret:reconcile:08a1b:r3:test": "node scripts/test-08a1b-r3-semantic-triage.mjs",
    "secret:reconcile:08a1b:r3:verify": "node scripts/verify-08a1b-r3-semantic-triage.mjs --inventory docs/production-readiness/evidence/08a1b-r2-logical-credential-inventory.sanitized.json --classification docs/production-readiness/evidence/08a1b-r3-semantic-classification.sanitized.json --supersession docs/production-readiness/evidence/08a1c-external-r4/current-semantic-triage-status.sanitized.json --current-manifest docs/production-readiness/evidence/08a1c-external-r4/external-action-manifest.sanitized.json --current-authority docs/production-readiness/evidence/08a-owner-authority-records.sanitized.json --artifact-gate docs/production-readiness/evidence/08a1d-r3-semantic-gate.sanitized.json",
    "secret:reconcile:08a1c:semantic:verify": "node scripts/verify-08a1c-r4-semantic-status.mjs --classification docs/production-readiness/evidence/08a1b-r3-semantic-classification.sanitized.json --status docs/production-readiness/evidence/08a1c-external-r4/current-semantic-triage-status.sanitized.json --manifest docs/production-readiness/evidence/08a1c-external-r4/external-action-manifest.sanitized.json --authority docs/production-readiness/evidence/08a-owner-authority-records.sanitized.json",
    "secret:reconcile:08a1c": "npm run secret:reconcile:08a1b:r3:verify",
    "secret:reconcile:08a1c:r4-audit": "sh scripts/reconcile-08a1c.sh",
    "secret:reconcile:08a1c:test": "node scripts/test-08a1c-r4-reconstruction.mjs",
    "secret:reconcile:08a1c:external:verify": "npm run secret:reconcile:08a1b:r3:verify",
    "secret:reconcile:08a1c:external:test": "node scripts/test-08a1c-r4-reconstruction.mjs",
    "secret:reconcile:08a1c:artifact-consistency:test": "node scripts/test-08a1c-artifact-consistency.mjs",
    "secret:artifacts:08a1d": "node scripts/verify-08a1d-semantic-gate.mjs --classification docs/production-readiness/evidence/08a1b-r3-semantic-classification.sanitized.json --gate docs/production-readiness/evidence/08a1d-r3-semantic-gate.sanitized.json",
    "secret:artifacts:08a1d:r4-audit": "node scripts/scan-08a1d-artifacts.mjs --run-id 20260811T214249Z --manifest runtime/secret-scan/20260811T214249Z/canonical-inventory.08a1b.sanitized.json --scan-summary runtime/secret-scan/20260811T214249Z/summary.jsonl --report-dir runtime/secret-scan/20260811T214249Z/artifact-coverage-08a1d --output-json runtime/secret-scan/20260811T214249Z/artifact-coverage.08a1d.sanitized.json",
    "secret:artifacts:08a1d:verify": "node scripts/verify-08a1d-semantic-gate.mjs --classification docs/production-readiness/evidence/08a1b-r3-semantic-classification.sanitized.json --gate docs/production-readiness/evidence/08a1d-r3-semantic-gate.sanitized.json",
    "secret:artifacts:08a1d:r4-audit:verify": "node scripts/verify-08a1d-r4-mapping.mjs --source-inventory docs/production-readiness/evidence/08a1b-r2-logical-credential-inventory.sanitized.json --resolution docs/production-readiness/evidence/08a1c-r4-dispositions.r4-audit.sanitized.json --mapping docs/production-readiness/evidence/08a1d-r4-artifact-mapping.sanitized.json",
    "secret:artifacts:08a1d:test": "node scripts/test-08a1d-artifact-coverage.mjs && node scripts/test-08a1d-r4-mapping.mjs",
    "git:verify-push-size": "node scripts/verify-git-push-size.mjs",
    "git:verify-tree-size": "node scripts/verify-git-push-size.mjs --tree HEAD",
    "git:push-size:test": "node scripts/test-git-push-size.mjs",
    "git:hooks:install": "git config core.hooksPath .githooks",
    "hf:models:add": "node scripts/huggingface-models.mjs add",
    "hf:models:download": "node scripts/huggingface-models.mjs download",
    "hf:models:build": "node scripts/huggingface-models.mjs build",
    "hf:models:status": "node scripts/huggingface-models.mjs status"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/generated-site"
  ]
}
