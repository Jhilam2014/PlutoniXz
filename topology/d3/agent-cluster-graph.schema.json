{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "metadata",
    "nodes",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "group",
          "risk_level",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type",
          "weight"
        ],
        "additionalProperties": true
      }
    }
  }
}
