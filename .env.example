FRONTEND_PORT=5173
BACKEND_PORT=8080
GENERATED_SITE_PORT=5174
PROJECT_PORT_START=5300
PROJECT_PORT_END=5399
PROJECT_PREVIEW_PORT_RETRY_TIMEOUT_MS=120000
PROJECT_SELECT_PREVIEW_TIMEOUT_MS=15000
PROJECT_HOST_URL=http://localhost
PROJECT_RUNTIME_MODE=docker
PROJECT_RUNTIME_IMAGE=
PROJECT_RUNTIME_NETWORK=
PROJECTS_ROOT=/workspace/apps
PROJECTS_REGISTRY_PATH=/workspace/project/runtime/projects.json
PROJECT_EXPORTS_ROOT=/workspace/project/runtime/exports
PROJECTS_GITIGNORE_PATH=/workspace/.gitignore
# Optional versioned agreement registry. Missing or invalid data leaves
# cross-application information sharing denied.
ENTERPRISE_SHARING_AGREEMENTS_PATH=/workspace/project/runtime/enterprise-sharing/agreements.json
VITE_BACKEND_URL=http://localhost:8080
VITE_GENERATED_SITE_URL=http://localhost:5174

# Google SSO login
# Google Cloud Console OAuth Client must authorize the exact JavaScript origin
# used in the browser. Local default:
# http://localhost:5173
# Also add http://127.0.0.1:5173 only if you intentionally use that URL.
# This frontend uses Google Identity Services ID-token popup sign-in, so no
# out-of-band redirect URI is used by the app.
VITE_GOOGLE_CLIENT_ID=157086996973-99v36v13ikq0bhsi3bomc38i4e6mghqd.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production Decision Continuity identity. Configure any standards-compliant
# OIDC issuer/broker (including a broker that fronts SAML); values are not
# browser secrets. The backend validates signed bearer tokens and resolves
# subjects to PostgreSQL memberships before authorizing a tenant action.
PLUTOMIX_AUTH_MODE=oidc
PLUTOMIX_CORS_ORIGINS=http://localhost:5173
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=RS256,RS384,RS512,ES256,ES384,ES512
OIDC_ACCEPTED_TOKEN_TYPES=JWT,at+jwt
OIDC_JWKS_CACHE_MS=300000
OIDC_JWKS_STALE_GRACE_MS=300000
OIDC_CLOCK_SKEW_SECONDS=60
# Development-only header identity. Production refuses to start when enabled.
PLUTOMIX_DEV_AUTH_ENABLED=false
VITE_PLUTOMIX_DEV_AUTH_ENABLED=false
# Development-only principal already provisioned in identity_principals and
# identity_tenant_memberships. It is never accepted when NODE_ENV=production.
PLUTOMIX_DEV_AUTH_SUBJECT=local:local-plutomix-user
VITE_PLUTOMIX_DEV_AUTH_SUBJECT=local:local-plutomix-user

# Optional Google just-in-time onboarding. When enabled, every Google identity
# with a server-verified email receives team_member access to this one tenant.
# The exact issuer + subject + email triple below receives tenant_admin access
# and the cross-tenant platform table. The tenant selector is the logical
# tenant_id; the expected instance key prevents accidental namespace drift.
PLUTOMIX_GOOGLE_JIT_ONBOARDING_ENABLED=false
PLUTOMIX_GOOGLE_JIT_TENANT_ID=
PLUTOMIX_GOOGLE_JIT_TENANT_INSTANCE_KEY=
PLUTOMIX_GOOGLE_JIT_ADMIN_ISSUER=https://accounts.google.com
PLUTOMIX_GOOGLE_JIT_ADMIN_SUBJECT=
PLUTOMIX_GOOGLE_JIT_ADMIN_EMAIL=

GENERATED_SITE_DIR=/workspace/generated-site
GENERATED_SITE_INTERNAL_URL=http://generated-site:5174
RESTART_GENERATED_CONTAINER=false
CODEX_VERSION=0.151.0
CODEX_BIN=/usr/local/bin/codex
CODEX_HOME=/workspace/codex-home
# Host path mounted read/write at CODEX_HOME. Defaults to ${HOME}/.codex in Compose.
HOST_CODEX_HOME=
CODEX_WORKFLOW_TIMEOUT_MS=600000
CLAUDE_VERSION=2.1.251
CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_WORKFLOW_TIMEOUT_MS=600000
CLAUDE_WORKFLOW_MAX_TURNS=40
GOTHAM_RUNTIME_PROBE=true
# Task-selected policy compilation is mandatory for managed Gotham execution.
GOTHAM_COMPILED_POLICY_CONTEXT_ENABLED=true
GOTHAM_COMPILED_CONTEXT_TARGET_TOKENS=10000
GOTHAM_COMPILED_CONTEXT_HARD_TOKENS=24000
# Infrastructure-only replay after a successful health check; capped to one in code.
PLUTOMIX_INFRASTRUCTURE_REPLAY_LIMIT=1
# Read-only Account & Usage capability checks use existing Gotham runtimes.
# Values are scoped to a verified PlutoMix profile; this never reads CLI credentials.
GOTHAM_ACCOUNT_USAGE_CACHE_MS=30000
GOTHAM_ACCOUNT_USAGE_PROBE_TIMEOUT_MS=3000
GOTHAM_ACCOUNT_USAGE_APP_SERVER_TIMEOUT_MS=15000
# Authoritative startup and per-workflow test of the actual Codex workspace sandbox.
# Gotham blocks execution and skips repair if this cannot initialize.
GOTHAM_SANDBOX_PREFLIGHT=true
# Leave false to use the classic shell path proven by the mounted-workspace
# preflight. Enable only after the same preflight passes with unified_exec.
GOTHAM_UNIFIED_EXEC_ENABLED=false
# Orchestrator health audits are user-triggered from the control panel only.
# The backend persists and enforces at most three attempts per local day.
PLUTOMIX_ORCHESTRATOR_HEALTH_MONITOR=1
PLUTOMIX_ORCHESTRATOR_HEALTH_MAX_DAILY_AUDITS=3
PLUTOMIX_ORCHESTRATOR_HEALTH_TIME_ZONE=Asia/Kolkata
# Durable deterministic workflow projection publisher. Canonical decision
# persistence is never disabled by these projection controls.
GOTHAM_PUBLICATION_ENABLED=true
GOTHAM_PUBLICATION_MAX_ATTEMPTS=5
GOTHAM_PUBLICATION_RETRY_BASE_MS=1000
# Must remain true; false fails closed and leaves durable receipts pending.
GOTHAM_PUBLICATION_IDLE_ONLY=true
GOTHAM_PUBLICATION_LOCK_STALE_MS=900000
# Optional override; defaults to runtime/workflow-publication-outbox/.
GOTHAM_PUBLICATION_OUTBOX_PATH=
GOTHAM_SANDBOX_PREFLIGHT_TIMEOUT_MS=8000
# Optional model used once when the configured Gotham model requires a newer CLI.
# Used only when the configured Codex model is newer than the installed CLI.
GOTHAM_FALLBACK_MODEL=
NODE_ENV=development
ORCHESTRATOR_ARCHIVE_PATH=/workspace/project/orchestrator-temp/orchestrator-agent-001-main.zip
ORCHESTRATOR_INSTALL_ENABLED=true
ORCHESTRATOR_BOOTSTRAP_ENABLED=true
ORCHESTRATOR_BOOTSTRAP_TIMEOUT_MS=900000

# Orchestrator bootstrap additions
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DEFAULT_MODEL=gpt-5
OPENAI_AGENT_VECTOR_STORE_ID=
OPENAI_AGENT_VECTOR_STORE_NAME=agent_knowledge_global
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_READ_ENABLED=true
AGENT_MEMORY_WRITE_ENABLED=true
AGENT_MEMORY_SYNC_ENABLED=true
# Sync only after the system is idle and this many changed/unindexed memory files are pending.
AGENT_MEMORY_SYNC_MIN_PENDING_FILES=5
# At most three agent-memory sync attempts are scheduled per Asia/Kolkata day.
# Busy Gotham work produces no deferred sync event; the next idle/periodic check
# handles pending memory instead.
AGENT_MEMORY_SYNC_MAX_RUNS_PER_DAY=3
AGENT_MEMORY_SYNC_INTERVAL_MS=28800000
AGENT_MEMORY_SYNC_TIME_ZONE=Asia/Kolkata
AGENT_CAPABILITY_LEARNING_ENABLED=true
AGENT_KNOWLEDGE_DB_PROVIDER=firebase_data_connect
AGENT_KNOWLEDGE_DB_URL=
AGENT_KNOWLEDGE_DB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATA_CONNECT_SERVICE_ID=
FIREBASE_DATA_CONNECT_LOCATION=
POSTGRES_URL=
DATABASE_URL=
# Decision Continuity uses PostgreSQL as its only production authority. `file`
# is an explicitly local development/test adapter and is rejected in production.
DECISION_CONTINUITY_ADAPTER=file
DECISION_CONTINUITY_DATABASE_URL=
DECISION_CONTINUITY_MAX_RECONSIDERATIONS_PER_TENANT_PER_DAY=25
DECISION_CONTINUITY_RECONSIDERATION_COOLDOWN_MS=1800000
# User-triggered, source-cited architecture discovery. Model assistance is
# bounded and optional; static source analysis remains authoritative.
PROJECT_BRANCH_DISCOVERY_MODEL_ASSIST_ENABLED=true
PROJECT_BRANCH_DISCOVERY_MODEL=
PROJECT_BRANCH_DISCOVERY_MAX_MODEL_CALLS=8
PROJECT_BRANCH_DISCOVERY_MODEL_TIMEOUT_MS=15000

# Step 5: disabled by default. Enable globally and name each permitted tenant
# only after migration 008, service-identity provisioning, and a bounded
# deterministic-fixture validation. The planner may use only registered
# read-only collectors; it has no policy, approval, promotion, write, or shell capability.
QAGENT_DECISION_CONTINUITY_ENABLED=false
QAGENT_DECISION_CONTINUITY_ENABLED_TENANTS=
QAGENT_DECISION_CONTINUITY_READ_ONLY_TOOLS=deterministic_fixture
QAGENT_DECISION_CONTINUITY_EVIDENCE_SOURCES=deterministic_fixture,authorized_catalog
QAGENT_DECISION_CONTINUITY_MAX_ITERATIONS=1
QAGENT_DECISION_CONTINUITY_MAX_FAN_OUT=4
QAGENT_DECISION_CONTINUITY_MAX_TOKENS=4000
QAGENT_DECISION_CONTINUITY_MAX_MODEL_CALLS=1
QAGENT_DECISION_CONTINUITY_MAX_TOOL_CALLS=1
QAGENT_DECISION_CONTINUITY_MAX_ELAPSED_MS=60000
QAGENT_DECISION_CONTINUITY_MAX_COST_USD=0.25
QAGENT_DECISION_CONTINUITY_MAX_COMPUTE_UNITS=1
QAGENT_DECISION_CONTINUITY_MAX_EVIDENCE_BYTES=65536
QAGENT_DECISION_CONTINUITY_MIN_EXPECTED_INFORMATION_GAIN=0.10
QAGENT_DECISION_CONTINUITY_DEDUPLICATION_THRESHOLD=0.72
QAGENT_LIVE_EVAL_ENABLED=false
QAGENT_LIVE_EVAL_MAX_COST_USD=0.25

# Step 6: BrainX is a governed model registry and isolated fixture boundary.
# It does not download models, allocate accelerators, submit cloud jobs, or call
# a live provider. Enable only after migration 009 and tenant-specific review.
# The Enterprise BrainX rollout remains off until a tenant has an immutable
# application binding, policy snapshot, budget envelope, and fresh evidence.
BRAINX_ENABLED=false
BRAINX_ENABLED_TENANTS=
BRAINX_AVAILABLE_HARDWARE=fixture
BRAINX_MAX_CONCURRENCY=1
BRAINX_MAX_FALLBACKS=1
BRAINX_MAX_RETRIES=0
BRAINX_MAX_ELAPSED_MS=30000
BRAINX_MAX_INPUT_BYTES=32768
BRAINX_MAX_OUTPUT_BYTES=32768
BRAINX_MAX_COST_USD=0.25
BRAINX_CIRCUIT_FAILURE_THRESHOLD=2
BRAINX_LIVE_PROVIDER_ENABLED=false
BRAINX_LIVE_PROVIDER_MAX_COST_USD=0
# Automatic Hugging Face selection/download is not an execution path. A
# Hugging Face artifact must instead be staged with an immutable revision,
# provenance, licence, checksum, hardware, and human approval record.
PLUTOMIX_HF_AUTO_DOWNLOAD=false

# AIX performs governed model selection only. It never calls a provider itself;
# a tenant must enable BrainX and have an approved policy/budget context first.
AIX_GOVERNED_ROUTING_ENABLED=false
AIX_MAX_ROUTE_COST_USD=1
AIX_MAX_LATENCY_MS=60000
AIX_PERMITTED_TASK_ROLES=generation
AIX_RECEIPT_RETENTION=decision_continuity

# ResearchX is an opt-in, allowlisted, audit-only worker. All three flags and
# a named tenant/domain allowlist are required before it can fetch anything.
RESEARCHX_ENABLED=false
RESEARCHX_WORKER_ENABLED=false
RESEARCHX_NETWORK_ENABLED=false
RESEARCHX_ENABLED_TENANTS=
RESEARCHX_ALLOWED_DOMAINS=
RESEARCHX_CADENCE_MS=86400000
RESEARCHX_MIN_CADENCE_MS=60000
RESEARCHX_MAX_CADENCE_MS=2678400000
RESEARCHX_MAX_BYTES_PER_SOURCE=131072
RESEARCHX_FETCH_TIMEOUT_MS=10000
RESEARCHX_MAX_REDIRECTS=2
RESEARCHX_MAX_SOURCES_PER_CYCLE=8
RESEARCHX_MAX_RUNS_PER_SOURCE_PER_DAY=4
RESEARCHX_WORKER_INTERVAL_MS=60000
RESEARCHX_MAX_EVIDENCE_CHARS=3000
RESEARCHX_ALLOW_HTTP=false
RESEARCHX_WORKER_HEALTH_PORT=8082
RESEARCHX_WORKER_PRINCIPAL_ID=
RESEARCHX_WORKER_STOP_GRACE_PERIOD=30s

# AgenticX shares only sanitized, tenant-scoped knowledge after policy checks.
# It defaults off; raw secrets and restricted content are never shareable.
AGENTICX_KNOWLEDGE_ENABLED=false
AGENTICX_KNOWLEDGE_ENABLED_TENANTS=
AGENTICX_KNOWLEDGE_ALLOWED_CLASSIFICATIONS=public,internal,confidential
AGENTICX_KNOWLEDGE_ALLOWED_REGIONS=
AGENTICX_KNOWLEDGE_ALLOWED_PURPOSES=
AGENTICX_KNOWLEDGE_ALLOWED_TRANSFORMATIONS=summary,redacted_summary,metadata
AGENTICX_KNOWLEDGE_DEFAULT_MAX_CLASSIFICATION=internal
AGENTICX_KNOWLEDGE_MAX_RESULTS=10
AGENTICX_KNOWLEDGE_MAX_SUMMARY_CHARS=1200
AGENTICX_KNOWLEDGE_MAX_RETENTION_DAYS=365
DECISION_CONTINUITY_DURABLE_WORKFLOWS=false
DECISION_CONTINUITY_WORKER_CONCURRENCY=8
DECISION_CONTINUITY_WORKER_TENANT_CONCURRENCY=2
DECISION_CONTINUITY_WORKER_TENANT_QUEUE_LIMIT=100
DECISION_CONTINUITY_WORKER_LEASE_MS=30000
DECISION_CONTINUITY_WORKER_MAX_ATTEMPTS=5
DECISION_CONTINUITY_WORKER_MAX_REDRIVES=2
DECISION_CONTINUITY_WORKER_POLL_MS=500
DECISION_CONTINUITY_WORKER_SHUTDOWN_GRACE_MS=20000
DECISION_CONTINUITY_WORKER_HEALTH_PORT=8081
# Internal principal provisioned in identity_principals for the worker. It must
# hold only workflow:execute and its explicitly assigned job-type scopes.
DECISION_CONTINUITY_WORKER_PRINCIPAL_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AGENT_GRAPH_DB_ENABLED=true
AGENT_GRAPH_DB_PROVIDER=neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
VECTOR_DB_PROVIDER=auto
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
CHROMADB_URL=
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIRECTORY=.chroma/agent-memory
APP_BASE_URL=
API_BASE_URL=
PLUTOMIX_API_BODY_LIMIT=256kb
# Off by default. Legacy Landlock can be incompatible with provider permission
# profiles; fix the Bubblewrap host policy instead of weakening the preflight.
GOTHAM_USE_LEGACY_LANDLOCK_FALLBACK=false
# Required in production. Values are provider references, never plaintext keys.
PLUTOMIX_SECRETS_PROVIDER=
PLUTOMIX_ENCRYPTION_KEY_REF=
PLUTOMIX_EGRESS_ALLOWLIST=

# Gotham Chat AI Accounts. PostgreSQL is mandatory in production; the JSON
# metadata file is development-only. CLI credentials remain in provider-owned
# isolated homes/keychains and are never stored in either metadata repository.
AI_PROVIDER_DATABASE_URL=
AI_PROVIDER_PROFILE_STORE=/workspace/runtime/ai-provider-profiles/metadata.json
AI_PROVIDER_RUNTIME_ROOT=/workspace/runtime/ai-provider-profiles
# Keep false for Docker/headless deployments. Set true only when the Codex
# localhost:1455 OAuth callback is explicitly reachable from the user's browser.
AI_PROVIDER_CODEX_BROWSER_CALLBACK_AVAILABLE=false
COPILOT_BIN=copilot
CURSOR_AGENT_BIN=cursor-agent
EMERGENT_BIN=emergent

# Gotham Studio AI/ML execution control plane. Provider credentials are
# backend-only and must never use VITE_ prefixes or be entered in the UI.
# PostgreSQL is mandatory when NODE_ENV=production. `file` is a development-
# only fallback; leave the path empty to use database/gotham-studio/state.json.
GOTHAM_STUDIO_REPOSITORY=file
GOTHAM_STUDIO_DATABASE_URL=
GOTHAM_STUDIO_STATE_PATH=
GOTHAM_STUDIO_RECONCILIATION_INTERVAL_MS=30000
GOTHAM_STUDIO_MAX_RECONCILIATIONS_PER_CYCLE=50
GOTHAM_STUDIO_PROVIDER_TIMEOUT_MS=20000
GOTHAM_STUDIO_PROVIDER_RETRIES=1
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_AUTH_MODE=backend_token
DATABRICKS_JOBS_API_VERSION=2.2
DATABRICKS_MLFLOW_ENABLED=false
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_WORKSPACE_NAME=
AZURE_ML_ACCESS_TOKEN=
AZURE_ML_API_VERSION=2026-03-01
AZURE_ML_MANAGEMENT_ENDPOINT=https://management.azure.com

# Self-Improvement Control Plane
SELF_IMPROVEMENT_ENABLED=true
SELF_IMPROVEMENT_MODE=sandbox
# Run one local baseline cycle while the backend service starts. Runtime event
# cycles and health self-healing are off by default so Gotham instructions stay isolated.
SELF_IMPROVEMENT_STARTUP_CYCLE_ENABLED=true
PLUTOMIX_SELF_IMPROVEMENT_RUNTIME_EVENTS=false
PLUTOMIX_ORCHESTRATOR_SELF_HEAL=false
SELF_IMPROVEMENT_SCHEDULE_MS=0
SELF_IMPROVEMENT_MODEL_PROFILE=
SELF_IMPROVEMENT_MAX_CALLS_PER_CYCLE=2
SELF_IMPROVEMENT_MAX_TOKENS_PER_CYCLE=12000
SELF_IMPROVEMENT_MAX_COST_PER_DAY=1
SELF_IMPROVEMENT_MIN_SIGNAL_COUNT=3
SELF_IMPROVEMENT_MIN_CONFIDENCE=0.65
SELF_IMPROVEMENT_AUTO_PROMOTE_MAX_RISK=low
SELF_IMPROVEMENT_POST_PROMOTION_WINDOW_MS=1800000
SELF_IMPROVEMENT_AUTO_ROLLBACK=true
# Step 4 governed runtime-policy selector. Both values must be explicitly true
# after migration 007 and platform-role provisioning; otherwise no candidate
# can affect the self-improvement runtime.
GOVERNED_PROMOTIONS_ENABLED=false
GOVERNED_PROMOTION_SELF_IMPROVEMENT_ENABLED=false
SELF_IMPROVEMENT_RETENTION_DAYS=30
SELF_IMPROVEMENT_STORE_INSTRUCTION_SAMPLES=false
SELF_IMPROVEMENT_ADMIN_USER_IDS=
SELF_IMPROVEMENT_EVENT_CHECK_ENABLED=true
SELF_IMPROVEMENT_EVENT_TRIGGER_MIN_SCORE=0.78
SELF_IMPROVEMENT_EVENT_WINDOW_MS=600000
SELF_IMPROVEMENT_EVENT_MIN_RELATED_SIGNALS=3
SELF_IMPROVEMENT_EVENT_TRIGGER_COOLDOWN_MS=900000
SELF_IMPROVEMENT_RANDOM_AUDIT_RATE=0.01
SELF_IMPROVEMENT_RESEARCH_ENABLED=false
SELF_IMPROVEMENT_RESEARCH_ALLOW_NETWORK=false
SELF_IMPROVEMENT_RESEARCH_MAX_CALLS_PER_DAY=2
SELF_IMPROVEMENT_RESEARCH_MAX_TOKENS_PER_DAY=8000
SELF_IMPROVEMENT_RESEARCH_MAX_COST_PER_DAY=0.5
SELF_IMPROVEMENT_RESEARCH_SOURCES=
# Optional investor/customer discovery enrichment. Keep real keys only in .env.
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io
APIFY_USER_ID=
APIFY_API_KEY=
APIFY_LINKEDIN_INVESTOR_ACTOR_ID=harvestapi/linkedin-profile-search
APIFY_LINKEDIN_INVESTOR_MAX_ITEMS=20
APIFY_LINKEDIN_INVESTOR_TAKE_PAGES=1
SELF_IMPROVEMENT_TOOL_BUILD_ENABLED=true
SELF_IMPROVEMENT_TOOL_PLAN_AUTO_TRIGGER=true
SELF_IMPROVEMENT_TOOL_PLAN_COOLDOWN_MS=1800000
SELF_IMPROVEMENT_MAX_TOOL_BUILDS_PER_DAY=4
SELF_IMPROVEMENT_MONETARY_APPROVAL_REQUIRED=true
SELF_IMPROVEMENT_MONETARY_APPROVAL_THRESHOLD_USD=0
