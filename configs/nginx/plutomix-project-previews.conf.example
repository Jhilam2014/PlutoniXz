# Install this file under /etc/nginx/sites-available after creating:
#   1. a wildcard DNS record for *.preview.plutomix.in, and
#   2. the wildcard certificate named plutomix-project-previews.
# Only the managed PlutoMix port range 5300-5399 can be selected.

map $http_upgrade $plutomix_preview_connection {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    # Quote the regular expression so Nginx does not parse the {2} quantifier
    # as the beginning of a configuration block.
    server_name "~^p(?<plutomix_project_port>53[0-9]{2})\.preview\.plutomix\.in$";

    ssl_certificate /etc/letsencrypt/live/plutomix-project-previews/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/plutomix-project-previews/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:$plutomix_project_port;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $plutomix_preview_connection;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
